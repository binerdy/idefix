<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="StageBackgroundBrush" Color="#FCFCFC" />
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F7F7F7" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="SubtleFillBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PillBorderBrush" Color="#E4E4E4" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="AccentFillBrush" Color="#111111" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UserBubbleBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="CitationBrush" Color="#5A4A00" />
      <SolidColorBrush x:Key="CitationHighlightBrush" Color="#FFF59D" Opacity="0.75" />
      <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#ECECEC" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E2E2E2" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D8D8D8" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#1A1A1A" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#1A1A1A" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#1A1A1A" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="#6E6E6E" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="StageBackgroundBrush" Color="#111317" />
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#16181C" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#22252A" />
      <SolidColorBrush x:Key="SubtleFillBrush" Color="#24272C" />
      <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1B1E22" />
      <SolidColorBrush x:Key="PillBorderBrush" Color="#2E3238" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA0A6" />
      <SolidColorBrush x:Key="AccentFillBrush" Color="#F2F2F2" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#111111" />
      <SolidColorBrush x:Key="UserBubbleBrush" Color="#22252A" />
      <SolidColorBrush x:Key="CitationBrush" Color="#FFD27A" />
      <SolidColorBrush x:Key="CitationHighlightBrush" Color="#FFB300" Opacity="0.35" />
      <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#181A1E" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#24272C" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2B2F35" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#33373E" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#ECECEC" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#ECECEC" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#ECECEC" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="#9AA0A6" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="InterFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>
  <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

  <x:Double x:Key="SidebarWidth">280</x:Double>
  <x:Double x:Key="StageMaxWidth">760</x:Double>


  <Style x:Key="IconGlyphStyle" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="SidebarItemButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="12,16,12,6" />
  </Style>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="HintTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="BorderlessTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
