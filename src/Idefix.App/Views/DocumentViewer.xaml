<UserControl x:Class="Idefix.App.Views.DocumentViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Idefix.App.Views"
             xmlns:vm="using:Idefix.App.ViewModels"
             xmlns:services="using:Idefix.App.Services">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="3*" MaxWidth="980" />
    </Grid.ColumnDefinitions>

    <Rectangle Grid.ColumnSpan="2" Fill="Black" Opacity="0.18" Tapped="OnBackdropTapped" />

    <Grid Grid.Column="1" Background="{ThemeResource ViewerBackgroundBrush}" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="1,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Padding="16,40,16,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}"
                ToolTipService.ToolTip="{x:Bind services:Strings.Get('PreviousPage')}" AutomationProperties.Name="{x:Bind services:Strings.Get('PreviousPage')}">
          <FontIcon Glyph="&#xE76B;" Style="{StaticResource IconGlyphStyle}" />
        </Button>
        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" FontSize="13" />
        <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}"
                ToolTipService.ToolTip="{x:Bind services:Strings.Get('NextPage')}" AutomationProperties.Name="{x:Bind services:Strings.Get('NextPage')}">
          <FontIcon Glyph="&#xE76C;" Style="{StaticResource IconGlyphStyle}" />
        </Button>
        <Button Grid.Column="4" Command="{x:Bind ViewModel.OpenOriginalCommand}" AutomationProperties.Name="{x:Bind services:Strings.Get('OpenOriginal')}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8A7;" FontSize="14" Style="{StaticResource IconGlyphStyle}" />
            <TextBlock Text="{x:Bind services:Strings.Get('OpenOriginal')}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.CloseCommand}"
                ToolTipService.ToolTip="{x:Bind services:Strings.Get('Close')}" AutomationProperties.Name="{x:Bind services:Strings.Get('Close')}">
          <FontIcon Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
        </Button>
      </Grid>

      <InfoBar Grid.Row="1" VerticalAlignment="Top" Margin="16" Severity="Warning" IsClosable="False"
               IsOpen="{x:Bind views:ViewHelpers.HasText(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

      <ScrollViewer x:Name="PageScroller" Grid.Row="1" Padding="24" ZoomMode="Enabled"
                    Visibility="{x:Bind ViewModel.IsPdf, Mode=OneWay}">
        <Grid x:Name="PageHost" HorizontalAlignment="Center">
          <Image x:Name="PageImage" Source="{x:Bind ViewModel.PageImage, Mode=OneWay}" Stretch="Uniform" SizeChanged="OnPageImageSizeChanged" />
          <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False" />
        </Grid>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" Padding="32,16" Visibility="{x:Bind views:ViewHelpers.CollapsedWhen(ViewModel.IsPdf), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Lines}" MaxWidth="760">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentLineViewModel">
              <Grid Margin="0,2">
                <Border CornerRadius="4" Background="{ThemeResource CitationHighlightBrush}" Visibility="{x:Bind IsHighlighted}" />
                <TextBlock Margin="6,4" Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="15" IsTextSelectionEnabled="True" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
